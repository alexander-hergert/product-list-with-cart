// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model users {
  id        String   @id
  role      String
  name      String
  email     String   @unique
  image     String
  createdAt DateTime @default(now())
}


model products {
  id          String @id
  name        String
  price       Float
  description String
  image       String
  rating      Float
}

model orders {
  id                String   @id
  userId            String
  name              String
  email             String
  productIds        String[]
  productIdsQuantity Int[]
  productIdsPrice   Float[]
  totalPrice        Float
  createdAt         DateTime @default(now())
}

model feedbacks {
  id        String   @id
  userId    String
  title     String
  productId String
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime
}