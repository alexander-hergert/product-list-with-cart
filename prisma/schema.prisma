// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model users {
  id        String   @id
  role      String
  name      String
  email     String   @unique
  address   String   @default("")
  image     String
  createdAt DateTime @default(now())
  orders  orders[]
  feedbacks feedbacks[]
}


model products {
  id          String @id
  name        String
  price       Float
  description String
  image       String
  rating      Float
  feedbacks   feedbacks[]
}

enum OrderStatus {
  Pending
  Shipped
  Delivered
  Cancelled
}

model orders {
  id                String   @id
  userId            String
  user              users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productIds        String[]
  productIdsQuantity Int[]
  productIdsPrice   Float[]
  totalPrice        Float
  createdAt         DateTime @default(now())
  status            OrderStatus @default(Pending)
  feedbacks         feedbacks[]
}

model feedbacks {
  id        String   @id
  productId String
  product   products @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String   
  order     orders   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title     String
  comment   String
  rating    Float   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
}